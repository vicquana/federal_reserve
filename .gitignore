.DS_Store
__pycache__/
*.pyc
.venv/

# Third-party / re-downloadable raw data: not committed. See
# docs/data_provenance.md for exact sources, checksums, and the
# download scripts (src/download_fed_minutes.py,
# src/download_fed_transcripts.py) that regenerate these bit-for-bit.
data/external/*.xlsx
data/raw/minutes/
data/raw/minutes_calib/
data/raw/transcripts/
data/raw/transcripts_calib/

# Large fully-regeneratable derived intermediates (see each script's
# docstring in src/ for the exact reproduction command). Small,
# human-inspectable derived outputs (vocabulary.csv, *_units.csv,
# *_vocab.csv, the calibration/results CSVs in docs/) stay tracked.
data/interim/analysis_units.csv
data/interim/counts.mtx
data/interim/transcripts_master.csv
data/interim/minutes_master.csv
data/interim/transcripts_calib_parsed.csv
